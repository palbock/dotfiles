# Global git config -> %USERPROFILE%\.gitconfig
# Name/email live in ~/.gitconfig.local (not in this repo), see README.
[include]
    path = ~/.gitconfig.local
[filter "lfs"]
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true
    clean = git-lfs clean -- %f
[push]
    default = simple
    autoSetupRemote = true
[diff]
    tool = vimdiff
[difftool]
    prompt = false
[alias]
    hist = log --pretty=format:\"%h %ad | %s%d [%an]\" --graph --date=short --color
    log = ! git log --oneline --color | emojify | less
    lg1="!git log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(bold yellow)%d%C(reset)' --all"
    cleanup = "!git branch --merged | grep  -v '\\*\\|master\\|develop' | xargs -n 1 git branch -d"
[pull]
    ff = only
[init]
    defaultBranch = main
[core]
    editor = 'C:\\Program Files\\Git\\usr\\bin\\vim.exe'
	autocrlf = false
